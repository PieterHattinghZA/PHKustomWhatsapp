<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PHKustom.ChatClient.ViewModels"
        xmlns:models="using:PHKustom.ChatClient.Models"
        xmlns:services="using:PHKustom.ChatClient.Services"
        x:Class="PHKustom.ChatClient.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PHKustom Chat Client" Width="1280" Height="800" MinWidth="900" MinHeight="600">
  <Grid RowDefinitions="*,Auto" ColumnDefinitions="260,*">
    <Border Grid.Row="0" Grid.Column="0" Background="#111B21" BorderBrush="#2A3942" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*">
        <Grid Margin="14" ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="Blikbrein Pyn" FontSize="20" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
              <Ellipse Width="8" Height="8" Fill="#00A884" VerticalAlignment="Center" />
              <TextBlock Text="Active chats (Auto-sync)" FontSize="11" Opacity="0.75" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshChatsCommand}" />
        </Grid>
        <TextBox Grid.Row="1" Margin="12,0,12,10" PlaceholderText="Search contacts or phone" Text="{Binding SearchText}" />
        <ListBox Grid.Row="2" ItemsSource="{Binding FilteredChats}" SelectedItem="{Binding SelectedChat}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ChatSummary">
              <Grid Margin="8" ColumnDefinitions="48,*">
                <Border Width="42" Height="42" CornerRadius="21" Background="#2A7F76" ClipToBounds="True">
                  <Panel>
                    <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16" />
                    <Image Source="{Binding AvatarUrl, Converter={x:Static services:ImageLoaderConverter.Instance}}" Stretch="UniformToFill" IsVisible="{Binding AvatarUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="{Binding FormattedName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding FormattedPhone}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <Border Padding="16" Background="#202C33">
        <Grid ColumnDefinitions="*,Auto,Auto">
          <StackPanel>
            <TextBlock Text="{Binding SelectedChat.FormattedName, FallbackValue=Select an active chat}" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="{Binding SelectedChat.FormattedPhone}" Opacity="0.65" />
          </StackPanel>
          <Button Grid.Column="1" Margin="6,0" Content="Export CSV" Command="{Binding ExportCsvCommand}" />
          <Button Grid.Column="2" Margin="6,0" Content="Save Media" Command="{Binding ExportMediaCommand}" />
        </Grid>
      </Border>

      <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" Background="#0B141A">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="models:ChatMessage">
            <Border Margin="12,5" Padding="12" CornerRadius="8" Background="#202C33" MaxWidth="720" HorizontalAlignment="Left">
              <StackPanel>
                <TextBlock Text="{Binding FormattedTime}" FontSize="11" Opacity="0.6" />
                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" FontSize="14" Margin="0,2,0,0" />
                
                <Grid IsVisible="{Binding IsMedia}" Margin="0,8,0,0" MaxWidth="380" MaxHeight="280" HorizontalAlignment="Left">
                  <Border CornerRadius="8" ClipToBounds="True" Background="#111B21">
                    <Panel>
                      <Image Source="{Binding DownloadUrl, Converter={x:Static services:ImageLoaderConverter.Instance}}"
                             Stretch="UniformToFill"
                             MinHeight="140" MinWidth="200"
                             IsVisible="{Binding IsImage}" />
                      
                      <Border Background="#182229" MinHeight="140" MinWidth="200" IsVisible="{Binding IsVideo}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                          <TextBlock Text="🎬 Video" FontSize="16" Foreground="#8696A0" HorizontalAlignment="Center" />
                          <TextBlock Text="{Binding FileName}" FontSize="11" Foreground="#8696A0" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                      </Border>

                      <Border Background="#30000000" />

                      <Button Content="⬇ Download"
                              Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DownloadMediaCommand}"
                              CommandParameter="{Binding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Background="#00A884"
                              Foreground="White"
                              FontWeight="Bold"
                              Padding="14,8"
                              CornerRadius="18" />
                    </Panel>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border Grid.Row="2" Padding="12" Background="#202C33">
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding MessageText}" PlaceholderText="Type a message" AcceptsReturn="True" MinHeight="42" />
          <Button Grid.Column="1" Margin="10,0,0,0" Content="Send" Command="{Binding SendCommand}" MinWidth="80" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,220,Auto" Background="#182229" Margin="0">
      <TextBlock Margin="10,6" Text="{Binding Status}" />
      <ProgressBar Grid.Column="1" Margin="8" Minimum="0" Maximum="100" Value="{Binding Progress}" />
      <Button Grid.Column="2" Margin="8" Content="Clean cache" Command="{Binding CleanupCacheCommand}" />
    </Grid>
  </Grid>
</Window>
